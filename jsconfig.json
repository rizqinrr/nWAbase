{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/**/*.js", "plugins/**/*.js", "scripts/**/*.js", "eslint.config.js"],
  "exclude": ["node_modules", "store", "coverage", "dist"]
}
