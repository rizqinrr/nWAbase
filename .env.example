BOT_NAME=nWAbase

# Comma-separated phone numbers without spaces, for example: 62XXXXXXXXXX,62YYYYYYYYYY
OWNER_NUMBER=

# Comma-separated command prefixes, for example: !,.
PREFIX=!

# Optional custom pairing code; leave empty to generate one automatically
PAIRING_CODE=

# Boolean values accept true, false, 1, or 0
USE_PAIRING_CODE=true
WATCH_PLUGINS=false

SESSION_DB_PATH=./store/session.db
APP_DB_PATH=./store/app.db
